# App
APP_URL=http://localhost:3000

# Database — local docker Postgres. Supabase (Connect → ORMs / connection strings):
#  DATABASE_URL = transaction pooler (port 6543), used by the app at runtime:
#    postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require
#  DIRECT_URL   = session pooler (port 5432), used only by `prisma migrate`/studio:
#    postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
#  `uselibpqcompat=true&sslmode=require` = TLS without CA check (Supabase's CA isn't in Node's store).
DATABASE_URL=postgresql://upworkrecord:upworkrecord@localhost:5434/upworkrecord
DIRECT_URL=

# Object storage — any S3-compatible API.
#  local RustFS: endpoint http://localhost:9100, path-style
#  AWS S3:       S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false, S3_REGION = bucket region, keys = IAM user (see README)
#  Supabase:     https://<project>.supabase.co/storage/v1/s3, path-style, keys from Storage → S3 access keys
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=upworkrecord
S3_ACCESS_KEY_ID=upworkrecord
S3_SECRET_ACCESS_KEY=upworkrecord-secret
S3_FORCE_PATH_STYLE=true

# Auth (personal use): web login password, cookie signing secret, Mac app bearer token.
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-hex-32
API_TOKEN=generate-with-openssl-rand-hex-24

# AI proposals (OpenRouter). Empty key → the Generate button explains what's missing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-nano

# Override ffmpeg binary; empty → bundled ffmpeg-static
FFMPEG_PATH=

# Upwork MCP OAuth: public https base (set by `pnpm tunnel` in dev; leave empty in prod to use APP_URL)
UPWORK_OAUTH_BASE_URL=
