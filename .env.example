# Production env (Vercel → Project → Settings → Environment Variables).
# Local dev uses .env.sample (docker Postgres + RustFS) instead.

# ── App + auth ───────────────────────────────────────────────
# no trailing slash
APP_URL=https://your-domain.vercel.app
# web login password
ADMIN_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 24 — same value in Mac app Settings
API_TOKEN=

# ── Supabase Postgres (dashboard → Connect → Connection string) ──
# Runtime: transaction pooler, port 6543
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require
# Migrations (`pnpm db:deploy`): session pooler, port 5432
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# ── AWS S3 (private bucket + IAM user, policy in README) ─────
S3_ENDPOINT=                                       # empty for AWS
S3_REGION=eu-central-1
S3_BUCKET=upworkrecord-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── AI (OpenRouter) ──────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-nano

# ── Optional ─────────────────────────────────────────────────
OPENROUTER_AUDIO_MODEL=
# empty → APP_URL
UPWORK_OAUTH_BASE_URL=
# Override ffmpeg binary; empty → bundled ffmpeg-static
FFMPEG_PATH=
